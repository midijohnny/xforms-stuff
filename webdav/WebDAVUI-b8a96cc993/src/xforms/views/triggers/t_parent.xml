<xf:trigger
	id="t_parent"
	ref="/explorer/controls/parent"
	xmlns:xf="http://www.w3.org/2002/xforms" 
	xmlns:ev="http://www.w3.org/2001/xml-events">
	<xf:label class="icon icon-parent"/>
 	<xf:action ev:event="DOMActivate">
		<xf:setvalue ref="/explorer/cwd" value="parentDir(.)"/>
		<xf:setvalue ref="/explorer/cfile"/>
		<xf:send name="do-list-collection" targetid="model"/>
	</xf:action>
</xf:trigger>
